# Public-web / LinkedIn enrichment via Tavily Search
TAVILY_API_KEY=

# Hard credit controls. Basic Search is explicitly used: 1 credit per uncached query.
# Production runs an exact requisition-post search followed by a reusable
# company/role recruiter search. Two strong post authors may receive cached
# profile lookup; UF-engineer remains opt-in via --deep-enrich.
TAVILY_AUTO_SEARCH_KINDS=exact_post,recruiter
TAVILY_AUTO_AUTHOR_LOOKUP=true
TAVILY_MAX_AUTHOR_LOOKUPS_PER_JOB=2
TAVILY_MAX_QUERIES=2
TAVILY_MAX_CREDITS_PER_RUN=20
TAVILY_CREDIT_RESERVE=100
TAVILY_REQUIRE_USAGE_CHECK=true
TAVILY_MAX_LEADS_PER_JOB=14

# Maximum queued Discord internship alerts delivered in one run.
MAX_ALERTS_PER_RUN=20
MAX_NETWORKING_JOBS_PER_RUN=30

# Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# SQLite DB location
DB_PATH=data/jobs.db

# Candidate eligibility profile
EXPECTED_GRAD_YEAR=2029
CANDIDATE_SPECIAL_PROGRAM_ELIGIBLE=false
