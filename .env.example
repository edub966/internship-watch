# Public-web / LinkedIn enrichment via Tavily Search
TAVILY_API_KEY=

# Hard credit controls. Basic Search is explicitly used: 1 credit per uncached query.
# Production auto-enrichment defaults to the reusable recruiter search only.
# exact_post and uf_engineer are opt-in via --deep-enrich.
TAVILY_AUTO_SEARCH_KINDS=recruiter
TAVILY_MAX_QUERIES=3
TAVILY_MAX_CREDITS_PER_RUN=10
TAVILY_DAILY_CREDIT_CAP=20
TAVILY_CREDIT_RESERVE=250
TAVILY_REQUIRE_USAGE_CHECK=true

# Maximum queued Discord internship alerts delivered in one run.
MAX_ALERTS_PER_RUN=20
MAX_NETWORKING_JOBS_PER_RUN=20

# Discord webhook for alerts
DISCORD_WEBHOOK_URL=

# SQLite DB location
DB_PATH=data/jobs.db
